---
interface Props {
  /** without a link the button is shown inactive, e.g. for something that is not available yet */
  href?: string;
  /** full-size button aligned with the text instead of centred */
  align?: "center" | "start";
}

const { href, align = "center" } = Astro.props;
// links that leave the docs, e.g. to a shop, open in a new tab
const external = href && /^https?:/.test(href) ? { target: "_blank", rel: "noopener" } : {};
---

<div class:list={["cta-container", { "cta-start": align === "start" }]}>
  {href ? (
    <a class="cta-button" href={href} {...external}><slot /></a>
  ) : (
    <span class="cta-button cta-inactive"><slot /></span>
  )}
</div>

<style>
  /* Aligned with the evcc.io homepage button (.content .button) */
  .cta-container {
    text-align: center;
    margin: 3rem 0;
  }
  .cta-button {
    display: inline-block;
    background-color: #0ba631;
    color: #ffffff;
    font-weight: bold;
    font-size: 1.25em;
    padding: 0.75em 2em;
    border-radius: 2em;
    text-decoration: none;
    transition: background-color 0.2s ease-in;
  }
  .cta-button:hover {
    background-color: #076f20;
  }
  .cta-button.cta-inactive,
  .cta-button.cta-inactive:hover,
  :global([data-theme="dark"]) .cta-button.cta-inactive {
    background-color: var(--sl-color-gray-5);
    color: var(--sl-color-gray-2);
    cursor: default;
  }
  .cta-start {
    text-align: start;
    margin: 2rem 0 1.25rem;
  }
  :global([data-theme="dark"]) .cta-button {
    background-color: #0fdd42;
    color: #00002d;
  }
  :global([data-theme="dark"]) .cta-button:hover {
    background-color: #0fdd42;
  }
</style>
