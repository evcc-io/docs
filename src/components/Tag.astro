---
// Label chip for running content. Reuses the .tag styles of the device lists.
interface Props {
  variant?: "default" | "accent" | "caution";
}

const { variant = "default" } = Astro.props;
const variantClass = {
  default: "tag-feature",
  accent: "tag-sponsorship",
  caution: "tag-caution",
}[variant];
---

<span class:list={["tag", "tag-md", variantClass]}><slot /></span>
