---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { deviceIconSvg } from "@utils/deviceIcon";

interface Props {
  title: string;
  /** with a link the whole card is clickable, without one it is a plain tile */
  href?: string;
  to?: string;
  description?: string;
  icon?: string;
  /** check mark next to the title, for checklist tiles */
  check?: boolean;
  /** x mark next to the title, for things that do not work */
  cross?: boolean;
  /** info mark next to the title, for things to be aware of */
  info?: boolean;
  image?: ImageMetadata;
  /** manufacturer website, shown as a text link at the end of the card */
  site?: string;
  /** icon shown like a photo: an evcc device icon as "<list>/<device>", e.g. "chargers/go-e-charger-gemini", or the markup of an SVG file imported with ?raw */
  deviceIcon?: string;
  /** flatter plate, for a picture that is much wider than tall */
  wide?: boolean;
  /** several device icons shown together on the plate, for a card that stands for a group */
  deviceIcons?: string[];
  fullWidth?: boolean;
  highlight?: boolean;
}

const { title, href, to, description, icon, check = false, cross = false, info = false, image, deviceIcon, deviceIcons, wide = false, site, fullWidth = false, highlight = false } = Astro.props;
// a device without an icon of its own gets the generic one of its list
const iconSvgs = await Promise.all(
  (deviceIcons ?? (deviceIcon ? [deviceIcon] : [])).map(async (key) => {
    if (key.trimStart().startsWith("<")) return key;
    const [list = "", slug = ""] = key.split("/");
    return (await deviceIconSvg(list, slug)) ?? (await deviceIconSvg(list, "generic.ext"));
  }),
);
const target = href ?? to;
const Tag = target ? "a" : "div";
// links that leave the docs, e.g. to a manufacturer, open in a new tab
const external = target && /^https?:/.test(target) ? { target: "_blank", rel: "noopener" } : {};
const classes = [
  "nav-card",
  fullWidth ? "nav-card-full" : "",
  highlight ? "nav-card-highlight" : "",
  check || cross || info ? "nav-card-check" : "",
  cross ? "nav-card-cross" : "",
  info ? "nav-card-info" : "",
  wide ? "nav-card-wide" : "",
].filter(Boolean).join(" ");
---

<Tag class={classes} href={target} {...external}>
  {image && (
    <div class="photo-panel nav-card-image">
      <Image src={image} alt="" width={800} quality={90} />
    </div>
  )}
  {iconSvgs.length === 1 && <div class="photo-panel nav-card-image" aria-hidden="true" set:html={iconSvgs[0]} />}
  {iconSvgs.length > 1 && (
    <div class="photo-panel nav-card-image nav-card-icons" aria-hidden="true">
      {iconSvgs.map((svg) => <div set:html={svg} />)}
    </div>
  )}
  {info && (
    <svg class="nav-card-check-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="9.5" />
      <path d="M12 11.5v5M12 7.5v.01" />
    </svg>
  )}
  {cross && (
    <svg class="nav-card-check-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M6 6l12 12M18 6L6 18" />
    </svg>
  )}
  {check && (
    <svg class="nav-card-check-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M5 12l5 5L20 7" />
    </svg>
  )}
  <div class="nav-card-body">
    <h3 class="nav-card-title">
      {icon && <span class="nav-card-icon">{icon}</span>}
      {title}
    </h3>
    {description && <p class="nav-card-desc">{description}</p>}
    <slot />
    {site && (
      <a class="nav-card-site" href={site} target="_blank" rel="noopener">
        {new URL(site).hostname.replace(/^www\./, "")}
      </a>
    )}
  </div>
  {target && (
    <svg class="nav-card-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M9 6l6 6-6 6" />
    </svg>
  )}
</Tag>

<style>
  .nav-card {
    display: block;
    /* Starlight adds a top margin between sibling blocks, which would shift the second card */
    margin-top: 0;
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 1rem;
    background: var(--sl-color-bg);
    text-decoration: none;
    overflow: hidden;
    transition: border-color 0.15s, background 0.15s;
  }
  /* Starlight's sibling margin would push the text below the photo or icon */
  .nav-card > :global(*) {
    margin-top: 0;
  }
  a.nav-card:hover {
    border-color: var(--sl-color-text-accent);
    background: var(--sl-color-gray-6);
  }
  .nav-card-full {
    grid-column: 1 / -1;
  }
  .nav-card-highlight {
    border-color: var(--sl-color-text-accent);
  }
  a.nav-card-highlight:hover {
    border-color: var(--sl-color-text-accent);
    background: var(--sl-color-gray-6);
  }

  /* Photo: a plate flush with the card edges, same format for every photo */
  .nav-card-image {
    width: calc(100% + 3rem);
    margin: -1.25rem -1.5rem 1.1rem;
    aspect-ratio: 3 / 2;
  }

  /* Several icons on one plate: three per row */
  .nav-card-icons {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-auto-rows: minmax(0, 1fr);
    gap: 2% 4%;
    padding: 5% 12%;
    box-sizing: border-box;
  }
  .nav-card-icons > :global(div) {
    display: flex;
    justify-content: center;
    min-height: 0;
  }
  .nav-card-icons :global(svg) {
    width: auto;
    height: 100%;
    aspect-ratio: 1;
  }

  /* Text */
  .nav-card-title {
    margin: 0;
    font-size: 1.05rem;
    color: var(--sl-color-text-accent);
    font-weight: 700;
  }
  div.nav-card .nav-card-title {
    color: var(--sl-color-white);
  }
  .nav-card-icon {
    margin-right: 0.5rem;
  }
  .nav-card-body > .nav-card-site {
    display: block;
    width: fit-content;
    font-size: 0.925rem;
  }
  .nav-card-body > :global(*) {
    margin-top: 0;
    margin-bottom: 0;
  }
  .nav-card-body > :global(* + *) {
    margin-top: 0.6rem;
  }
  .nav-card-desc,
  .nav-card :global(p),
  .nav-card :global(ul) {
    color: var(--sl-color-text);
    font-size: 0.925rem;
    line-height: 1.5;
  }
  .nav-card :global(ul) {
    padding-left: 1.1rem;
  }
  .nav-card :global(li) {
    margin: 0;
  }

  /* Collapsible block inside a card */
  .nav-card :global(details) {
    font-size: 0.925rem;
    /* the arrow is enough, drop Starlight's left border */
    border-inline-start: 0;
    padding-inline-start: 0;
  }
  .nav-card :global(summary) {
    cursor: pointer;
    color: var(--sl-color-text-accent);
    font-weight: 600;
  }
  .nav-card :global(details[open] > summary) {
    margin-bottom: 0.5rem;
  }

  /* Checklist tile: <NavCard check>, <NavCard cross> for things that do not work, <NavCard info> for things to be aware of */
  .nav-card-check {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 1rem 1.1rem;
  }
  .nav-card-check-icon {
    flex: none;
    width: 1.25rem;
    height: 1.25rem;
    margin-top: 0.15rem;
    color: var(--sl-color-text-accent);
  }
  .nav-card-cross .nav-card-check-icon {
    color: var(--sl-color-red);
  }
  .nav-card-info .nav-card-check-icon {
    color: var(--sl-color-gray-3);
  }
  .nav-card-check .nav-card-title {
    font-size: 1rem;
  }
  .nav-card-check .nav-card-body > :global(* + *) {
    margin-top: 0.25rem;
  }

  /* Row layout, set by <NavCardGrid rows>: one wide card per entry, photo
     plate on the left, flush with the card */
  .nav-card-chevron {
    display: none;
  }
  :global(.nav-card-rows) .nav-card {
    display: flex;
    align-items: stretch;
    padding: 0;
  }
  /* a hovered row keeps its background, so it does not blend with the photo
     plate; the border and the arrow turn green */
  :global(.nav-card-rows) a.nav-card:hover {
    background: var(--sl-color-bg);
  }
  :global(.nav-card-rows) a.nav-card:hover .nav-card-chevron {
    color: var(--sl-color-text-accent);
  }
  :global(.nav-card-rows) .nav-card-image {
    --photo-inset: 12%;
    flex: none;
    /* grows with the card, so wide screens get a larger photo */
    width: clamp(6.5rem, 36%, 20rem);
    aspect-ratio: 5 / 4;
    margin: 0;
  }
  @media (max-width: 30rem) {
    :global(.nav-card-rows) .nav-card-image {
      width: 6.5rem;
    }
  }
  /* flat picture (about 2:1): a narrower plate with the same space on all four sides */
  :global(.nav-card-grid) .nav-card-wide .nav-card-image {
    --photo-inset: 17%;
    width: clamp(6.5rem, 27%, 15rem);
    aspect-ratio: 3 / 2;
  }
  :global(.nav-card-rows) .nav-card-body {
    flex: 1;
    min-width: 0;
    align-self: center;
    padding: 1rem 1.5rem;
  }
  :global(.nav-card-rows) .nav-card-title {
    color: var(--sl-color-white);
  }
  :global(.nav-card-rows) .nav-card-chevron {
    display: block;
    flex: none;
    align-self: center;
    width: 1.25rem;
    height: 1.25rem;
    margin-right: 1.25rem;
    color: var(--sl-color-gray-3);
  }
</style>
