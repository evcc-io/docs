---
import BlogMarkdownContent from "starlight-blog/overrides/MarkdownContent.astro";

// starlight-blog looks up a fallback blog post (e.g. /nl/blog/… before it is
// translated) by its locale-less id and misses the English entry, because our
// default locale is not root. Hand it the English id; links stay localised.
const route = Astro.locals.starlightRoute;
if (route.isFallback && route.entry.id.startsWith("en/blog/")) {
  route.id = route.entry.id;
}
---

<BlogMarkdownContent><slot /></BlogMarkdownContent>
