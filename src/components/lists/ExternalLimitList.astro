---
import { getCollection } from "astro:content";
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import DeviceCardList from "@components/DeviceCardList.astro";
import UserDefinedHint from "@components/UserDefinedHint.astro";
import ChannelListNav from "@components/ChannelListNav.astro";
import { sortDevices, collectionName, nightlyPageHead } from "@utils/devices";
import type { Channel } from "@utils/devices";
import { intro } from "@utils/intros";

interface Props {
  lang: string;
  channel: Channel;
}
const { lang, channel } = Astro.props;
const isNightly = channel === "nightly";

const coll = await getCollection(collectionName("hems", lang, channel) as any);
const devices = sortDevices(coll as any);
const curtailerColl = await getCollection(collectionName("curtailers", lang, channel) as any);
const curtailers = sortDevices(curtailerColl as any);
const basePath = `/${lang}${isNightly ? "/nightly" : ""}/external-limit`;

const title = Astro.locals.t("list.external-limit.title");
const description = Astro.locals.t("list.external-limit.description");
const integrationsTitle = Astro.locals.t("list.integrations");
const curtailmentTitle = Astro.locals.t("list.curtailment");
const Intro = intro(lang, "external-limit");
const CurtailmentIntro = intro(lang, "curtailment-devices");
const Outro = intro(lang, "external-limit-outro");

const headings = [
  ...Intro.getHeadings(),
  { depth: 2, slug: "integrations", text: integrationsTitle },
  { depth: 2, slug: "curtailment-devices", text: curtailmentTitle },
  ...CurtailmentIntro.getHeadings(),
  ...Outro.getHeadings(),
];

const frontmatter = {
  title,
  description,
  template: "doc",
  ...(isNightly ? { pagefind: false, head: nightlyPageHead } : {}),
};
---

<StarlightPage frontmatter={frontmatter} headings={headings}>
  {isNightly && <ChannelListNav lang={lang} channel={channel} category="external-limit" />}
  <Intro.Content />
  <h2 id="integrations">{integrationsTitle}</h2>
  <DeviceCardList
    devices={devices as any}
    lang={lang}
    basePath={basePath}
    noBrandLabel={Astro.locals.t("list.genericIntegrations")}
    unbrandedFirst
  />
  {channel === "release" && (
    <UserDefinedHint lang={lang} kind="hems" nightlyHref={`/${lang}/nightly/external-limit`} />
  )}
  <h2 id="curtailment-devices">{curtailmentTitle}</h2>
  <CurtailmentIntro.Content />
  <DeviceCardList devices={curtailers as any} lang={lang} basePath={basePath} />
  {channel === "release" && (
    <UserDefinedHint
      lang={lang}
      kind="curtailer"
      nightlyHref={`/${lang}/nightly/external-limit#curtailment-devices`}
    />
  )}
  <Outro.Content />
</StarlightPage>
