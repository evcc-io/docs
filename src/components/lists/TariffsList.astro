---
import { getCollection } from "astro:content";
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import DeviceCardList from "@components/DeviceCardList.astro";
import TariffsIntro from "@components/intros/TariffsIntro.astro";
import UserDefinedHint from "@components/UserDefinedHint.astro";
import ChannelListNav from "@components/ChannelListNav.astro";
import {
  sortDevices,
  TARIFF_GROUPS,
  collectionName,
  nightlyPageHead,
} from "@utils/devices";
import type { Channel } from "@utils/devices";

interface Props {
  lang: "de" | "en";
  channel: Channel;
}
const { lang, channel } = Astro.props;
const isNightly = channel === "nightly";

const coll = await getCollection(collectionName("tariffs", lang, channel) as any);
const devices = sortDevices(coll as any);
const basePath = `/${lang}${isNightly ? "/nightly" : ""}/tariffs`;

const title = lang === "de" ? "Tarife & Vorhersagen" : "Tariffs & forecasts";
const description =
  lang === "de"
    ? "Dynamische Stromtarife sowie Anbieter für CO₂-, PV- und Temperaturvorhersagen."
    : "Dynamic electricity tariffs and CO₂, solar, and temperature forecast providers.";

type Bucket = "price" | "feedin" | "co2" | "solar" | "temperature";

const buckets: Record<Bucket, any[]> = {
  price: [],
  feedin: [],
  co2: [],
  solar: [],
  temperature: [],
};
for (const d of devices) {
  const group = TARIFF_GROUPS[d.data.product.group ?? ""] ?? "price";
  if (group !== "price") {
    buckets[group].push(d);
    continue;
  }
  // price templates without usages fit both directions
  const usages: string[] = d.data.usages ?? [];
  if (usages.length === 0 || usages.includes("grid")) buckets.price.push(d);
  if (usages.length === 0 || usages.includes("feedin")) buckets.feedin.push(d);
}

const sectionLabels = lang === "de"
  ? {
      price: { id: "price", title: "Netzbezugstarife" },
      feedin: { id: "feedin", title: "Einspeisetarife" },
      co2: { id: "co2", title: "CO₂-Vorhersagen" },
      solar: { id: "solar", title: "Solar-Vorhersagen" },
      temperature: { id: "temperature", title: "Temperaturvorhersagen" },
    }
  : {
      price: { id: "price", title: "Grid tariffs" },
      feedin: { id: "feedin", title: "Feed-in tariffs" },
      co2: { id: "co2", title: "CO₂ forecasts" },
      solar: { id: "solar", title: "Solar forecasts" },
      temperature: { id: "temperature", title: "Temperature forecasts" },
    };

const sectionOrder = ["price", "feedin", "co2", "solar", "temperature"] as const;

const headings = [
  ...(lang === "de"
    ? [
        { depth: 2, slug: "kinds", text: "Tarifarten" },
        { depth: 2, slug: "forecasts", text: "Vorhersagen" },
      ]
    : [
        { depth: 2, slug: "kinds", text: "Tariff kinds" },
        { depth: 2, slug: "forecasts", text: "Forecasts" },
      ]),
  ...sectionOrder
    .filter((k) => buckets[k].length > 0)
    .map((k) => ({ depth: 2, slug: sectionLabels[k].id, text: sectionLabels[k].title })),
];

const frontmatter = {
  title,
  description,
  template: "doc",
  ...(isNightly ? { pagefind: false, head: nightlyPageHead } : {}),
};
---

<StarlightPage frontmatter={frontmatter} headings={headings}>
  {channel === "nightly" && <ChannelListNav lang={lang} channel={channel} category="tariffs" />}
  <TariffsIntro lang={lang} />
  {
    sectionOrder.map((k) =>
      buckets[k].length > 0 ? (
        <>
          <h2 id={sectionLabels[k].id}>{sectionLabels[k].title}</h2>
          <DeviceCardList
            devices={buckets[k] as any}
            lang={lang}
            basePath={basePath}
            showCountries={true}
          />
        </>
      ) : null
    )
  }
  {channel === "release" && (
    <UserDefinedHint lang={lang} kind="tariff" nightlyHref={`/${lang}/nightly/tariffs`} />
  )}
</StarlightPage>
