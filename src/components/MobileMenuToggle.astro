---
// Starlight's mobile menu toggle with H2D2 Shopicons glyphs (Apache 2.0,
// https://github.com/H2D2-Design/h2d2-shopicons), placed at the start of the breadcrumb row
// below the header (see MobileBreadcrumbs.astro) and styled like the header's icon buttons.
---

<button
  popovertarget="starlight__sidebar"
  class="sl-menu-button sl-flex md:sl-hidden print:hidden"
>
  <svg
    class="open-menu"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 48 48"
    fill="currentColor"
    aria-hidden="true"
  >
    <rect x="8.036" y="12" width="31.964" height="4"></rect>
    <rect x="8.036" y="22" width="31.964" height="4"></rect>
    <rect x="8.036" y="32" width="31.964" height="4"></rect>
  </svg>
  <svg
    class="close-menu"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 48 48"
    fill="currentColor"
    aria-hidden="true"
  >
    <polygon
      points="40,5.172 24,21.172 8,5.172 5.171,8 21.172,24 5.171,40 8,42.828 24,26.828 40,42.828 42.828,40 26.828,24 42.828,8"
    ></polygon>
  </svg>
  <span class="sr-only">{Astro.locals.t("menuButton.accessibleLabel")}</span>
</button>

<style>
  @layer starlight.core {
    button {
      position: fixed;
      top: calc(
        var(--sl-nav-height) +
          (var(--sl-mobile-toc-height) - var(--sl-menu-button-size)) / 2
      );
      inset-inline-start: 1rem;
      z-index: var(--sl-z-index-navbar);
      border: 0;
      border-radius: 0.25rem;
      width: var(--sl-menu-button-size);
      height: var(--sl-menu-button-size);
      padding: 0.25rem;
      background-color: transparent;
      color: var(--sl-color-white);
      cursor: pointer;
    }
    :global([data-theme="light"]) button {
      color: #1c2445;
    }
    button:hover {
      background-color: var(--sl-color-gray-6);
      color: var(--sl-color-white);
    }
    button:has(~ :popover-open) {
      background-color: var(--sl-color-gray-5);
      color: var(--sl-color-white);
    }
    button:has(~ :popover-open) .open-menu {
      display: none;
    }
    button:not(:has(~ :popover-open)) .close-menu {
      display: none;
    }
    svg {
      width: 100%;
      height: 100%;
    }
  }
</style>

<style is:global>
  @layer starlight.core {
    body:has(#starlight__sidebar:popover-open) {
      overflow: hidden;
    }
    @media (min-width: 50rem) {
      body:has(#starlight__sidebar:popover-open) {
        overflow: auto;
      }
    }
  }
</style>
