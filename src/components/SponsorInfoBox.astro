---
import { renderMarkdown } from "@utils/devices";

interface Props {
  /** Unused, kept for existing MDX call sites; the page locale decides. */
  lang?: string;
  type?: "device" | "feature";
}
const { type = "device" } = Astro.props;

const t = {
  title: Astro.locals.t("sponsor.title"),
  body: Astro.locals.t(`sponsor.${type}`),
};
---

<aside class="starlight-aside starlight-aside--tip" aria-label={t.title}>
  <p class="starlight-aside__title">💚 {t.title}</p>
  <div class="starlight-aside__content" set:html={renderMarkdown(t.body)} />
</aside>
