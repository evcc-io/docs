---
interface Props {
  lang: string;
  kind?: "device" | "tariff" | "hems" | "messenger" | "curtailer";
  /** When set, the hint also points at the nightly version of the list. */
  nightlyHref?: string;
}

const { lang, kind = "device", nightlyHref } = Astro.props;

const issuesUrl = "https://github.com/evcc-io/evcc/issues/new/choose";
const userDefinedUrl = `/${lang}/user-defined-devices`;
const userDefinedAnchor =
  kind === "tariff"
    ? `${userDefinedUrl}#tariff`
    : kind === "hems"
      ? `${userDefinedUrl}#external-limit`
      : kind === "messenger"
        ? `${userDefinedUrl}#notification-service`
        : kind === "curtailer"
          ? `${userDefinedUrl}#curtailer`
          : userDefinedUrl;

// tariffs and messengers are services, hems are integrations, the rest devices
const noun =
  kind === "tariff" || kind === "messenger"
    ? "service"
    : kind === "hems"
      ? "integration"
      : "device";
const opts = { interpolation: { escapeValue: false } };
const featureRequest = Astro.locals.t("userDefined.featureRequest", {
  href: issuesUrl,
  ...opts,
});
const userDefined = Astro.locals.t(`userDefined.link.${noun}`, {
  href: userDefinedAnchor,
  ...opts,
});
const body = nightlyHref
  ? Astro.locals.t("userDefined.bodyNightly", {
      nightlyHref,
      featureRequest,
      userDefined,
      ...opts,
    })
  : Astro.locals.t("userDefined.body", { featureRequest, userDefined, ...opts });
const title = Astro.locals.t(`userDefined.title.${noun}`);
---

<aside class="starlight-aside starlight-aside--note" aria-label={title}>
  <p class="starlight-aside__title" aria-hidden="true">{title}</p>
  <p set:html={body} />
</aside>
