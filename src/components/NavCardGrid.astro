---
interface Props {
  /** one wide card per row, with the photo on the left */
  rows?: boolean;
  /** minimum column width, e.g. "12rem" for three narrow boxes side by side */
  min?: string;
}

const { rows = false, min } = Astro.props;
---

<div
  class:list={["nav-card-grid", { "nav-card-rows": rows }]}
  style={min ? `--nav-card-min: ${min}` : undefined}
>
  <slot />
</div>

<style>
  .nav-card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(var(--nav-card-min, 280px), 1fr));
    gap: 1rem;
    margin: 1.25rem 0;
  }
  .nav-card-rows {
    grid-template-columns: 1fr;
  }
</style>
