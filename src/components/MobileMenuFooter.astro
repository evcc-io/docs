---
// Starlight's mobile menu footer with only the theme toggle: Blog link, GitHub icon and
// language select stay in the header on small screens.
import ThemeSelect from "@components/ThemeSelect.astro";
---

<div class="mobile-preferences sl-flex">
  <ThemeSelect />
</div>

<style>
  @layer starlight.core {
    .mobile-preferences {
      justify-content: flex-end;
      border-top: 1px solid var(--sl-color-gray-6);
      padding: 0.5rem 0;
    }
  }
</style>
