---
// Compact language dropdown: two-letter codes at the header's font size, a Shopicons chevron
// on larger screens. Stores the choice for lang-redirect.js.
import config from "virtual:starlight/user-config";

const locales = config.locales ?? {};
const current = Astro.locals.starlightRoute.locale;

// same path in another locale: swap (or add) the first path segment
function localizedPathname(code: string): string {
  const segments = Astro.url.pathname.split("/").filter(Boolean);
  if (segments[0] && segments[0] in locales) segments[0] = code;
  else segments.unshift(code);
  return "/" + segments.join("/");
}
---

{
  config.isMultilingual && (
    <label class="lang-select">
      <span class="sr-only">{Astro.locals.t("languageSelect.accessibleLabel")}</span>
      <select
        autocomplete="off"
        onchange="localStorage.preferredLang = this.value.split('/')[1]; location.pathname = this.value"
      >
        {Object.keys(locales).map((code) => (
          <option value={localizedPathname(code)} selected={code === current}>
            {code.toUpperCase()}
          </option>
        ))}
      </select>
      {/* H2D2 Shopicons ArrowDown (Apache 2.0), https://github.com/H2D2-Design/h2d2-shopicons */}
      <svg class="caret" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" fill="currentColor" aria-hidden="true">
        <polygon points="24,29.172 9.414,14.586 6.586,17.414 24,34.828 41.414,17.414 38.586,14.586" />
      </svg>
    </label>
  )
}

<style>
  .lang-select {
    position: relative;
    display: flex;
    align-items: center;
    color: var(--sl-color-gray-2);
  }
  .lang-select:hover {
    color: var(--sl-color-white);
  }
  select {
    appearance: none;
    border: 0;
    padding-block: 0.625rem;
    padding-inline: 0.25rem 1.5rem;
    background-color: transparent;
    color: inherit;
    font: inherit;
    font-size: 1.125rem;
    cursor: pointer;
  }
  option {
    background-color: var(--sl-color-bg-nav);
    color: var(--sl-color-gray-1);
  }
  .caret {
    position: absolute;
    inset-inline-end: 0.25rem;
    width: 1rem;
    height: 1rem;
    pointer-events: none;
  }
  /* small screens: no chevron */
  @media (max-width: 50rem) {
    .caret {
      display: none;
    }
    select {
      padding-inline: 0.25rem;
    }
  }
</style>
