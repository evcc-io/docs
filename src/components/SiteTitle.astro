---
// Logo only, linking to evcc.io; Blog and Docs links live in the header navigation (SocialIcons).
import { logos } from "virtual:starlight/user-images";
---

<div class="site-title sl-flex">
  <a href="https://evcc.io/" class="site-title-logo">
    <img
      class="light:sl-hidden print:hidden"
      alt="evcc"
      src={logos.dark?.src}
      width={logos.dark?.width}
      height={logos.dark?.height}
    />
    <img
      class="dark:sl-hidden print:block"
      alt="evcc"
      src={logos.light?.src}
      width={logos.light?.width}
      height={logos.light?.height}
    />
  </a>
  <span class="site-tagline" translate="no">{Astro.locals.t("site.tagline")}</span>
</div>

<style>
  .site-title {
    align-items: center;
  }
  .site-title-logo {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    /* Same placement as on evcc.io: the wordmark's own padding is the only
       left margin. */
    margin-inline-start: calc(-1 * var(--sl-nav-pad-x));
  }
  .site-title-logo img {
    /* evcc.io renders the artwork at 64px for a 76-unit box (scale 0.842);
       this file crops the same artwork to 36 units, so 30.3px matches. The
       crop is not centred on the letters, so nudge them down like evcc.io. */
    height: 30.3px;
    width: auto;
    position: relative;
    top: 1.7px;
  }
  /* tagline like on evcc.io: starts at the wordmark's right edge, text
     baseline on the wordmark's baseline (measured 3.5px), larger screens only */
  .site-tagline {
    position: relative;
    top: 5.8px;
    font-size: 1.125rem;
    white-space: nowrap;
  }
  @media (max-width: 50rem) {
    .site-tagline {
      display: none;
    }
  }
</style>
