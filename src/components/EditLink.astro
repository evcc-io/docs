---
import Default from "@astrojs/starlight/components/EditLink.astro";
import { SOURCE_LOCALES } from "@utils/locales";

// Translated pages (not en/de, not an English fallback, not a device route)
// get a short AI-translation notice in front of the "Edit page" link.
const { editUrl, isFallback, locale } = Astro.locals.starlightRoute;
const notice =
  editUrl &&
  !SOURCE_LOCALES.includes(locale ?? "en") &&
  !isFallback &&
  !("lang" in Astro.params);
---

{
  notice ? (
    <div class="sl-flex translation-notice">
      <span>{Astro.locals.t("translationNotice.text")}</span>
      <Default />
    </div>
  ) : (
    <Default />
  )
}

<style>
  .translation-notice {
    flex-wrap: wrap;
    gap: 0.25rem 0.5rem;
    align-items: center;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
</style>
