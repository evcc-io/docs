---
import fs from "node:fs";
import { parse } from "yaml";
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import { localePaths } from "@utils/locales";
import { intro } from "@utils/intros";

export const getStaticPaths = localePaths;

const Intro = intro(Astro.params.lang!, "state");

// The state schemas are part of the bundled OpenAPI spec (synced from the main
// evcc repository, generated there from assets/js/types/evcc.ts).
type Raw = Record<string, any>;
const doc = parse(fs.readFileSync("public/openapi.yaml", "utf8"));
const allSchemas: Record<string, Raw> = doc.components.schemas;

// Only show schemas reachable from State — the rest belong to other endpoints.
const collectRefs = (node: any, refs: Set<string>) => {
  if (Array.isArray(node)) {
    node.forEach((entry) => collectRefs(entry, refs));
  } else if (node && typeof node === "object") {
    if (typeof node.$ref === "string") refs.add(node.$ref.split("/").pop()!);
    Object.values(node).forEach((value) => collectRefs(value, refs));
  }
};
const reachable = new Set(["State"]);
let queue = ["State"];
while (queue.length) {
  const refs = new Set<string>();
  collectRefs(allSchemas[queue.shift()!], refs);
  queue = queue.concat([...refs].filter((name) => !reachable.has(name) && allSchemas[name]));
  refs.forEach((name) => allSchemas[name] && reachable.add(name));
}

const anchor = (name: string) => name.toLowerCase();

interface TypeToken {
  text: string;
  href?: string;
}

const refToken = (ref: string): TypeToken => {
  const name = ref.split("/").pop()!;
  return { text: name, href: `#${anchor(name)}` };
};

const typeTokens = (schema: Raw): TypeToken[] => {
  if (schema.$ref) return [refToken(schema.$ref)];
  // nullable refs are wrapped in allOf with a single $ref
  if (schema.allOf?.length === 1 && schema.allOf[0].$ref) return [refToken(schema.allOf[0].$ref)];
  const variants: Raw[] | undefined = schema.anyOf ?? schema.oneOf;
  if (variants) {
    return variants.flatMap((variant, i): TypeToken[] => {
      const tokens = variant.enum
        ? [{ text: variant.enum.map((v: any) => JSON.stringify(v)).join(" | ") }]
        : typeTokens(variant);
      return i > 0 ? [{ text: " | " }, ...tokens] : tokens;
    });
  }
  if (schema.type === "array") {
    return [...(schema.items ? typeTokens(schema.items) : [{ text: "any" }]), { text: "[]" }];
  }
  if (schema.type === "object" && schema.additionalProperties) {
    if (schema.additionalProperties === true) return [{ text: "object" }];
    return [
      { text: "Record<string, " },
      ...typeTokens(schema.additionalProperties),
      { text: ">" },
    ];
  }
  if (schema.type === "string" && schema.format) return [{ text: `string (${schema.format})` }];
  return [{ text: String(schema.type ?? "object") }];
};

// reverse index: type name → list of "Schema.property" usage sites
const usedBy = new Map<string, { label: string; href: string }[]>();
for (const name of reachable) {
  const schema = allSchemas[name];
  for (const [propName, prop] of Object.entries(schema.properties ?? {})) {
    const refs = new Set<string>();
    collectRefs(prop, refs);
    for (const ref of refs) {
      if (!usedBy.has(ref)) usedBy.set(ref, []);
      usedBy.get(ref)!.push({
        label: `${name}.${propName}`,
        href: `#${anchor(name)}-${propName.toLowerCase()}`,
      });
    }
  }
  // union schemas reference types without properties
  if (schema.anyOf || schema.oneOf) {
    const refs = new Set<string>();
    collectRefs(schema.anyOf ?? schema.oneOf, refs);
    for (const ref of refs) {
      if (!usedBy.has(ref)) usedBy.set(ref, []);
      usedBy.get(ref)!.push({ label: name, href: `#${anchor(name)}` });
    }
  }
}
usedBy.forEach((sites) => sites.sort((a, b) => a.label.localeCompare(b.label)));

// State first, everything else alphabetical
const sections = [...reachable]
  .sort((a, b) => (a === "State" ? -1 : b === "State" ? 1 : a.localeCompare(b)))
  .map((name) => {
    const schema = allSchemas[name];
    const required: string[] = schema.required ?? [];
    return {
      name,
      anchor: anchor(name),
      description: schema.description as string | undefined,
      enumValues: schema.enum as string[] | undefined,
      unionTypes: schema.anyOf || schema.oneOf ? typeTokens(schema) : undefined,
      usedBy: usedBy.get(name) ?? [],
      properties: Object.entries(schema.properties ?? {})
        .sort(([a], [b]) => a.localeCompare(b))
        .map(([propName, prop]) => {
        const p = prop as Raw;
        return {
          name: propName,
          anchor: `${anchor(name)}-${propName.toLowerCase()}`,
          type: typeTokens(p),
          required: required.includes(propName),
          nullable: p.nullable === true,
          description: p.description as string | undefined,
          enumValues: p.enum as string[] | undefined,
        };
      }),
    };
  });

const title = "API State";
const description = Astro.locals.t("state.description");
const typesLabel = Astro.locals.t("state.types");

const frontmatter = { title, description, template: "doc" as const };
// root State properties render directly below the intro; referenced types are h3s under "Types"
const headings = [
  { depth: 2, slug: "top-level", text: "Top Level" },
  { depth: 2, slug: "types", text: typesLabel },
  ...sections.slice(1).map((section) => ({
    depth: 3,
    slug: section.anchor,
    text: section.name,
  })),
];
---

<StarlightPage frontmatter={frontmatter} headings={headings}>
  <Intro.Content />
  {
    sections.map((section, i) => (
      <>
        {i === 0 && <h2 id="top-level">Top Level</h2>}
        {i === 1 && <h2 id="types">{typesLabel}</h2>}
        {i > 0 && <h3 id={section.anchor}>{section.name}</h3>}
        {i > 0 && section.description && <p>{section.description}</p>}
        {i > 0 && section.usedBy.length > 0 && (
          <p class="sr-used-by">
            {"Used by: "}
            {section.usedBy.map((site, j) => (
              <>
                {j > 0 && ", "}
                <a href={site.href}>
                  <code>{site.label}</code>
                </a>
              </>
            ))}
          </p>
        )}
        {section.enumValues && (
          <p class="sr-enum">
            {section.enumValues.map((value) => (
              <code>{JSON.stringify(value)}</code>
            ))}
          </p>
        )}
        {section.unionTypes && (
          <p>
            {"One of: "}
            <span class="sr-type">
              {section.unionTypes.map((t) => (t.href ? <a href={t.href}>{t.text}</a> : t.text))}
            </span>
          </p>
        )}
        {section.properties.length > 0 && (
          <div class="sr-props">
            {section.properties.map((prop) => (
              <div class="sr-prop" id={prop.anchor}>
                <div class="sr-prop-head">
                  <a class="sr-prop-name" href={`#${prop.anchor}`}>
                    {prop.name}
                  </a>
                  <span class="sr-type">
                    {prop.type.map((t) => (t.href ? <a href={t.href}>{t.text}</a> : t.text))}
                  </span>
                  {prop.required && <span class="sr-tag sr-required">required</span>}
                  {prop.nullable && <span class="sr-tag">nullable</span>}
                </div>
                {prop.description && <p class="sr-prop-desc">{prop.description}</p>}
                {prop.enumValues && (
                  <p class="sr-prop-desc sr-enum">
                    {prop.enumValues.map((value) => (
                      <code>{JSON.stringify(value)}</code>
                    ))}
                  </p>
                )}
              </div>
            ))}
          </div>
        )}
      </>
    ))
  }
</StarlightPage>

<style>
  .sr-props {
    margin-top: 1rem;
  }
  .sr-prop {
    border-top: 1px solid var(--sl-color-hairline);
    padding: 0.6rem 0;
    scroll-margin-top: calc(var(--sl-nav-height) + 1rem);
  }
  .sr-prop-head {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    flex-wrap: wrap;
  }
  .sr-prop-name {
    font-family: var(--__sl-font-mono);
    font-weight: 600;
    color: var(--sl-color-white);
    text-decoration: none;
  }
  .sr-prop-name:hover::after {
    content: " #";
    color: var(--sl-color-gray-3);
  }
  .sr-type {
    font-family: var(--__sl-font-mono);
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
  .sr-type a {
    color: var(--sl-color-text-accent);
  }
  .sr-tag {
    font-size: var(--sl-text-xs);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    padding: 0 0.4rem;
    color: var(--sl-color-gray-3);
  }
  .sr-required {
    color: var(--sl-color-orange);
    border-color: var(--sl-color-orange-low);
  }
  .sr-prop-desc {
    margin: 0.2rem 0 0;
    font-size: var(--sl-text-sm);
  }
  .sr-used-by {
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
  .sr-used-by code {
    font-size: var(--sl-text-xs);
  }
  .sr-enum code {
    margin-inline-end: 0.4rem;
  }
</style>
